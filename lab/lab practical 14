#include<stdio.h>

int main()
{
    int i,n;
    char file[10][20];

    printf("Enter number of files: ");
    scanf("%d",&n);

    for(i=0;i<n;i++)
    {
        printf("File %d: ",i+1);
        scanf("%s",file[i]);
    }

    printf("\nFiles in Directory:\n");

    for(i=0;i<n;i++)
        printf("%s\n",file[i]);

    return 0;
}
