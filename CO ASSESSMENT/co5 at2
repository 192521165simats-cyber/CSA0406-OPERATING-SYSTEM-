  CPU AND MEMORY RESOURCE LIMITING
  BEGIN
    INPUT application_list

    FOR each app IN application_list DO
        CREATE resource_group for app

        SET CPU limit for app
        SET memory limit for app

        ASSIGN app processes TO resource_group

        MONITOR CPU and memory usage

        IF usage exceeds limit THEN
            THROTTLE CPU usage
            LIMIT memory allocation
        ENDIF
    ENDFOR

    PRINT "Resource usage is controlled"
END

  
